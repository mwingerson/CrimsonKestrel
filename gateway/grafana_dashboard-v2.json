      "id": 4,
      "title": "Latest Ambient Conditions (Fahrenheit)",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_telemetry"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature_c\" or r[\"_field\"] == \"humidity_pct\")\n  |> map(fn: (r) => ({\n      r with\n      _value: if r._field == \"temperature_c\" then r._value * 1.8 + 32.0 else r._value,\n      _field: if r._field == \"temperature_c\" then \"temperature_f\" else r._field\n    }))\n  |> last()",
          "refId": "LatestWeather"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
