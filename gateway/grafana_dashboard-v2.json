          {
            "matcher": {
              "id": "byName",
              "options": "temperature_f"
            },
            "properties": [
              {
                "id": "unit",
                "value": "fahrenheit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "humidity_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
