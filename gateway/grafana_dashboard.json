      "id": 1,
      "title": "Ambient Environmental Telemetry (Fahrenheit)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_telemetry"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature_c\" or r[\"_field\"] == \"environment_temperature_c\")\n  |> map(fn: (r) => ({ r with _value: r._value * 1.8 + 32.0, _field: \"temperature_f\" }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"temperature_f\")",
          "refId": "TempQuery"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"humidity_pct\" or r[\"_field\"] == \"environment_humidity_pct\")\n  |> map(fn: (r) => ({ r with _field: \"humidity\" }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"humidity\")",
          "refId": "HumQuery"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
