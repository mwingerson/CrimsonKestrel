            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"humidity_pct\" or r[\"_field\"] == \"environment_humidity_pct\")\n  |> last()\n  |> map(fn: (r) => ({ r with _field: \"Humidity\" }))\n  |> keep(columns: [\"_value\", \"_field\", \"_time\"])",
          "refId": "HumidityQuery"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> last()\n  |> keep(columns: [\"_time\"])\n  |> rename(columns: {\"_time\": \"_value\"})\n  |> map(fn: (r) => ({ r with _field: \"Last Seen\" }))",
          "refId": "LastSeenQuery"
