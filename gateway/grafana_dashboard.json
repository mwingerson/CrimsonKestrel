      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"system\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"bus_voltage_v\" or r[\"_field\"] == \"power_bus_voltage_v\" or r[\"_field\"] == \"client_id\")\n  |> last()\n  |> map(fn: (r) => ({\n      r with\n      _value: if r._field == \"client_id\" then r._value else if exists r.client_id then r.client_id else \"Unknown\",\n      _field: \"Node Name\"\n     }))\n  |> keep(columns: [\"_value\", \"_field\", \"_time\"])",
          "refId": "NodeNameQuery"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"system\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"version\" or r[\"_field\"] == \"system_version\")\n  |> last()\n  |> map(fn: (r) => ({ r with _field: \"Firmware\" }))\n  |> keep(columns: [\"_value\", \"_field\", \"_time\"])",
          "refId": "FirmwareQuery"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"system\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"bus_voltage_v\" or r[\"_field\"] == \"power_bus_voltage_v\")\n  |> last()\n  |> map(fn: (r) => ({ r with _field: \"Battery\" }))\n  |> keep(columns: [\"_value\", \"_field\", \"_time\"])",
          "refId": "BatteryQuery"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature_c\" or r[\"_field\"] == \"environment_temperature_c\")\n  |> last()\n  |> map(fn: (r) => ({\n      r with\n      _value: r._value * 1.8 + 32.0,\n      _field: \"Temperature\"\n     }))\n  |> keep(columns: [\"_value\", \"_field\", \"_time\"])",
          "refId": "TemperatureQuery"
        },
