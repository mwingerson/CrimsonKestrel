      "id": 3,
      "title": "Dew Point & Comfort Index",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_telemetry"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"weather\" or r[\"_measurement\"] == \"weather_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature_c\" or r[\"_field\"] == \"humidity_pct\")\n  |> last()\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      temp_f = r.temperature_c * 1.8 + 32.0\n      dew_f = temp_f - ((100.0 - r.humidity_pct) / 5.0)\n      return { _time: r._time, _field: \"Dew Point (\u00b0F)\", _value: dew_f }\n    })\n  |> keep(columns: [\"_value\", \"_field\", \"_time\"])",
          "refId": "DewPointQuery"
        }
      ],
